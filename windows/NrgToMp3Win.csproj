<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 10/11 version of ChurchSound. Built from the Mac with: windows/build-windows.sh -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>ChurchSound</AssemblyName>
    <RootNamespace>NrgToMp3Win</RootNamespace>
    <StartupObject>NrgToMp3Win.App</StartupObject>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- the build number shown in the title bar: one BUILD file for both the Mac and Windows apps -->
    <NrgBuild>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../BUILD').Trim())</NrgBuild>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Build</_Parameter1>
      <_Parameter2>$(NrgBuild)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- the same disc-image reading and converting code the Mac app uses -->
    <Compile Include="../Nrg.cs;../Wav.cs;../Id3.cs;../Program.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- keeps the GitHub access key unreadable to other Windows accounts -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- pitch shifting for Change Key (LGPL) -->
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport.Core" Version="2.3.2" />
  </ItemGroup>

</Project>
