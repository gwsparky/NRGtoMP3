<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 10/11 version of NRG to MP3. Built from the Mac with: windows/build-windows.sh -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <AssemblyName>NRG to MP3</AssemblyName>
    <RootNamespace>NrgToMp3Win</RootNamespace>
    <StartupObject>NrgToMp3Win.App</StartupObject>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- the same disc-image reading and converting code the Mac app uses -->
    <Compile Include="../Nrg.cs;../Wav.cs;../Id3.cs;../Program.cs" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <!-- pitch shifting for Change Key (LGPL) -->
    <PackageReference Include="SoundTouch.Net" Version="2.3.2" />
    <PackageReference Include="SoundTouch.Net.NAudioSupport.Core" Version="2.3.2" />
  </ItemGroup>

</Project>
